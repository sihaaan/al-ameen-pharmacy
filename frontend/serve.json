{
  "cleanUrls": false,
  "directoryListing": false,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/**", "destination": "/index.html" },
    { "source": "/about", "destination": "/index.html" },
    { "source": "/login", "destination": "/index.html" },
    { "source": "/register", "destination": "/index.html" },
    { "source": "/forgot-password", "destination": "/index.html" },
    { "source": "/reset-password/**", "destination": "/index.html" },
    { "source": "/profile", "destination": "/index.html" },
    { "source": "/product/**", "destination": "/index.html" },
    { "source": "/checkout", "destination": "/index.html" },
    { "source": "/order-confirmation", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "**", "headers": [
      { "key": "Cache-Control", "value": "no-store" },
      { "key": "X-Content-Type-Options", "value": "nosniff" }
    ] },
    { "source": "static/**", "headers": [
      { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
    ] }
  ]
}
