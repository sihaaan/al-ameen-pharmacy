# ==============================================================================
# BACKEND ENVIRONMENT VARIABLES - Example/Template File
# ==============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit the actual .env file to git!
# ==============================================================================

# Database Configuration
# Safe local default. This creates backend/db.sqlite3 and will not touch Neon.
DATABASE_URL=sqlite:///db.sqlite3

# Alternative local PostgreSQL example:
# DATABASE_URL=postgresql://pharmacy_dev:password@localhost:5432/pharmacy_dev

# Optional cloud development:
# Use a separate Neon development branch/database only, never the Railway
# production Neon DATABASE_URL. If you intentionally use a Neon dev branch with
# DEBUG=True, also set ALLOW_DEBUG_NEON_DATABASE=1.
# DATABASE_URL=postgresql://username:password@dev-neon-host.neon.tech/database_name?sslmode=require
# ALLOW_DEBUG_NEON_DATABASE=1
# Persistent PostgreSQL connections are health-checked before reuse. These
# defaults protect Railway/Neon requests from stale SSL connections.
# DATABASE_CONN_MAX_AGE_SECONDS=60
# DATABASE_CONN_HEALTH_CHECKS=1
# DATABASE_DISABLE_SERVER_SIDE_CURSORS=1
# DATABASE_CONNECT_TIMEOUT_SECONDS=8

# Django Security
DJANGO_SECRET_KEY=your-generated-secret-key-here-DO-NOT-USE-THIS-EXAMPLE
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Email Configuration
# For development (saves emails to files):
EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend

# For production (sends actual emails via SMTP):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-gmail-app-password-here
# DEFAULT_FROM_EMAIL=AL AMEEN PHARMACY <noreply@alameenpharmacy.com>
# ORDER_NOTIFICATION_EMAILS=orders@alameenpharmacy.com,manager@alameenpharmacy.com

# Optional Gmail OAuth for quotation/LPO discovery and explicit staff-reviewed
# quotation delivery. The website requests gmail.readonly plus gmail.send.
# Register this exact callback URL in the Google Cloud OAuth client.
# GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
# GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/quotations/gmail/oauth/callback/

# Optional Google Workspace HTTP Gmail add-on for one-click inquiry intake.
# Keep disabled until the HTTP deployment is installed and every value below
# matches its Google Cloud deployment. Audience values are the exact public
# contextual and action endpoint URLs, separated by commas.
GMAIL_ADDON_ENABLED=0
# GMAIL_ADDON_SERVICE_ACCOUNT_EMAIL=service-account@your-project.iam.gserviceaccount.com
# GMAIL_ADDON_SHARED_MAILBOX_EMAIL=shared-mailbox@example.com
# GMAIL_ADDON_OAUTH_CLIENT_ID=your-workspace-addon-oauth-client-id.apps.googleusercontent.com
# GMAIL_ADDON_ALLOWED_AUDIENCES=https://api.example.com/api/quotations/gmail/addon/contextual/,https://api.example.com/api/quotations/gmail/addon/action/
# GMAIL_ADDON_CONTEXTUAL_URL=https://api.example.com/api/quotations/gmail/addon/contextual/
# GMAIL_ADDON_ACTION_URL=https://api.example.com/api/quotations/gmail/addon/action/
# GMAIL_ADDON_HANDOFF_URL=https://app.example.com/admin?admin_tab=quotations&quotation_tab=inquiries
# GMAIL_ADDON_HANDOFF_TTL_SECONDS=1800
# GMAIL_ADDON_MAX_THREAD_MESSAGES=50
# Attachment evidence opened during staff review is bounded to 1-25 MiB.
# GMAIL_INQUIRY_ATTACHMENT_VIEW_MAX_BYTES=20971520

# Manual quotation source retention is local-filesystem backed in this release.
# Railway files are ephemeral unless this path is mounted on a persistent
# volume. Do not assume Cloudinary stores these private source files.
# QUOTATION_IMPORT_STORE_SOURCE_FILES=1
# QUOTATION_PRIVATE_STORAGE_ROOT=/mounted/private/quotations

# Quotation PDFs can embed uploaded branding/product images from trusted hosts.
# Keep arbitrary remote image fetching disabled unless you really need it.
QUOTATION_PDF_ALLOWED_REMOTE_IMAGE_HOSTS=res.cloudinary.com
# QUOTATION_PDF_ALLOW_REMOTE_IMAGES=0

# Cloudinary Configuration (verify the current provider plan separately)
# Sign up at https://cloudinary.com and copy your CLOUDINARY_URL
# Format: cloudinary://api_key:api_secret@cloud_name
# CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# Stripe Payment (Optional - only if using Stripe)
# STRIPE_SECRET_KEY=sk_test_your_test_key_here
# STRIPE_PUBLISHABLE_KEY=pk_test_your_test_key_here

# CORS Settings (Production)
# Comma-separated list of allowed frontend URLs
# CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Production Settings (only set these in production)
# DEBUG=0
# ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,api.yourdomain.com
# PRODUCTION_DATABASE_HOSTS=your-production-neon-host.neon.tech
# HTTPS redirect and secure-cookie settings are enabled by Django settings when
# DEBUG=0; they are not environment overrides in this release.

# Quotation AI-assisted import parsing (optional)
# API keys stay in environment variables. Staff enable/disable AI parsing from
# Admin Dashboard -> Quotations -> Settings. Leave keys blank to keep AI
# unavailable.
# OPENAI_API_KEY=sk-your-openai-key
# Anthropic is not implemented in this release; do not set it as the provider.
QUOTATION_AI_PARSE_GLOBAL_ENABLED=1
QUOTATION_AI_PARSE_PROVIDER=openai
QUOTATION_AI_PARSE_TEXT_MODEL=gpt-4.1-mini
QUOTATION_AI_PARSE_VISION_MODEL=gpt-4.1-mini
QUOTATION_AI_PARSE_MAX_TEXT_CHARS=20000
QUOTATION_AI_PARSE_MAX_PDF_PAGES=10
QUOTATION_AI_PARSE_MAX_RENDERED_PAGES=3
QUOTATION_AI_PARSE_IMAGE_MAX_DIMENSION=1400
QUOTATION_AI_PARSE_TIMEOUT_SECONDS=60
# Native Gmail PDF/Excel limits. These files are analyzed in one review-only
# request and are never persisted by the application.
QUOTATION_AI_NATIVE_TIMEOUT_SECONDS=180
QUOTATION_AI_NATIVE_MAX_FILES=12
QUOTATION_AI_NATIVE_MAX_TOTAL_BYTES=20971520
QUOTATION_AI_NATIVE_MAX_PDF_PAGES=25
# OpenAI spreadsheet augmentation reads at most the first 1,000 rows/sheet.
QUOTATION_AI_NATIVE_MAX_SPREADSHEET_ROWS_PER_SHEET=1000
# Must remain comfortably above the native AI timeout plus Gmail fetch time.
GUNICORN_TIMEOUT=300
# WEB_CONCURRENCY=2
# GUNICORN_THREADS=2
# Separate privacy opt-in for original Gmail PDF/Excel inputs. Requests
# to the configured provider use store=false and remain review-only.
QUOTATION_MAILBOX_AI_VISION_ENABLED=0

# Optional monitoring. Sentry is already installed and initializes only when
# SENTRY_DSN is present; send_default_pii remains disabled.
# SENTRY_DSN=https://public-key@your-sentry-host/project-id
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.0
# DJANGO_LOG_LEVEL=INFO
# DJANGO_REQUEST_LOG_LEVEL=ERROR
