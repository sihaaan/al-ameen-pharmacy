# ==============================================================================
# BACKEND ENVIRONMENT VARIABLES - Example/Template File
# ==============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit the actual .env file to git!
# ==============================================================================

# Database Configuration
# Safe local default. This creates backend/db.sqlite3 and will not touch Neon.
DATABASE_URL=sqlite:///db.sqlite3

# Alternative local PostgreSQL example:
# DATABASE_URL=postgresql://pharmacy_dev:password@localhost:5432/pharmacy_dev

# Optional cloud development:
# Use a separate Neon development branch/database only, never the Railway
# production Neon DATABASE_URL. If you intentionally use a Neon dev branch with
# DEBUG=True, also set ALLOW_DEBUG_NEON_DATABASE=1.
# DATABASE_URL=postgresql://username:password@dev-neon-host.neon.tech/database_name?sslmode=require
# ALLOW_DEBUG_NEON_DATABASE=1
# Persistent PostgreSQL connections are health-checked before reuse. These
# defaults protect Railway/Neon requests from stale SSL connections.
# DATABASE_CONN_MAX_AGE_SECONDS=60
# DATABASE_CONN_HEALTH_CHECKS=1
# DATABASE_DISABLE_SERVER_SIDE_CURSORS=1
# DATABASE_CONNECT_TIMEOUT_SECONDS=8

# Consumed only by the guarded migration runner in application code, but still
# visible to Railway build, pre-deploy, and running web processes because
# service variables are shared. Sealing prevents dashboard/API retrieval; it
# does not hide the value from build dependencies or runtime code. Do not make
# its role more privileged than the application role without explicit risk
# acceptance or an isolated migration service. This
# must be a direct/unpooled PostgreSQL URL for the same host lineage, port, and
# database as DATABASE_URL, with sslmode=require (or verify-ca/verify-full) for
# non-local hosts; prefer verify-full where supported. Do not use the normal
# Neon "-pooler" URL. The runner fails closed and never prints either URL.
# MIGRATION_DATABASE_URL=postgresql://application_user:password@direct-host/database_name?sslmode=require
# MIGRATION_CONNECT_TIMEOUT_SECONDS=8
# MIGRATION_LOCK_TIMEOUT_MS=10000
# MIGRATION_STATEMENT_TIMEOUT_MS=900000

# Django Security
DJANGO_SECRET_KEY=your-generated-secret-key-here-DO-NOT-USE-THIS-EXAMPLE
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Email Configuration
# For development (saves emails to files):
EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend

# For production (sends actual emails via SMTP):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-gmail-app-password-here
# DEFAULT_FROM_EMAIL=AL AMEEN PHARMACY <noreply@alameenpharmacy.com>
# ORDER_NOTIFICATION_EMAILS=orders@alameenpharmacy.com,manager@alameenpharmacy.com

# Optional Gmail OAuth for quotation/LPO discovery and explicit staff-reviewed
# quotation delivery. The website requests gmail.readonly plus gmail.send.
# Register this exact callback URL in the Google Cloud OAuth client.
# GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
# GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/quotations/gmail/oauth/callback/

# Optional Google Workspace HTTP Gmail add-on for one-click inquiry intake.
# Keep disabled until the HTTP deployment is installed and every value below
# matches its Google Cloud deployment. Audience values are the exact public
# contextual and action endpoint URLs, separated by commas.
GMAIL_ADDON_ENABLED=0
# GMAIL_ADDON_SERVICE_ACCOUNT_EMAIL=service-account@your-project.iam.gserviceaccount.com
# GMAIL_ADDON_SHARED_MAILBOX_EMAIL=shared-mailbox@example.com
# Leave disabled until the configured shared-mailbox address and the current
# GmailOAuthConnection profile have been verified to be the same mailbox.
QUOTATION_GMAIL_DESIGNATED_MAILBOX_ENFORCEMENT_ENABLED=0
# Privacy-safe employee-funnel metrics. Keep disabled until quotations.0039 is
# applied and the retention/monitoring owner has been approved.
QUOTATION_GMAIL_WORKFLOW_METRICS_ENABLED=0
# Persisted company approval and explicit uncertain-row review controls.
QUOTATION_GMAIL_REVIEW_UI_V2_ENABLED=0
# Optional stale-bound Save Review/Create Quotation and Save/Review Email
# actions. Enable only after Gmail review UI V2 is enabled and verified.
QUOTATION_GMAIL_CHAINED_ACTIONS_ENABLED=0
# Optional quotation-editor progressive rendering; disabled by default.
QUOTATION_EDITOR_PROGRESSIVE_LOAD_ENABLED=0
# Optional content-free Gmail analysis progress; disabled by default.
QUOTATION_GMAIL_ANALYSIS_PROGRESS_ENABLED=0
# Durable PostgreSQL-backed Gmail analysis jobs. Apply migration 0041 and
# configure a separate worker service before enabling; no worker is deployed
# by this repository configuration.
QUOTATION_GMAIL_BACKGROUND_ANALYSIS_ENABLED=0
# Internal compact-contract comparison only; baseline results stay authoritative.
QUOTATION_GMAIL_COMPACT_SCHEMA_SHADOW_ENABLED=0
# Internal clean-XLSX pre-extraction comparison only. Any uncertainty keeps the
# existing native-file result authoritative and skips the shadow provider call.
QUOTATION_GMAIL_XLSX_PREEXTRACT_SHADOW_ENABLED=0
# One-screen Gmail review + draft quotation preparation (also requires review UI V2).
QUOTATION_GMAIL_UNIFIED_WORKSPACE_ENABLED=0
# Keep Gmail company/source confirmation compact, then open the established
# quotation editor for item decisions and pricing. Effective only with review
# UI V2 plus stale-bound chained actions, and takes presentation precedence
# over the unified workspace. Set to 0 to restore the prior Gmail workspace
# routing; no data rollback is required.
QUOTATION_GMAIL_STANDARD_EDITOR_INTAKE_ENABLED=1
# Bounded parallel read-only Gmail intake retrieval. Keep disabled until the
# sequential/parallel equivalence checks pass for the designated mailbox.
QUOTATION_GMAIL_PARALLEL_FETCH_ENABLED=0
QUOTATION_GMAIL_PARALLEL_FETCH_LIMIT=4
# GMAIL_ADDON_OAUTH_CLIENT_ID=your-workspace-addon-oauth-client-id.apps.googleusercontent.com
# GMAIL_ADDON_ALLOWED_AUDIENCES=https://api.example.com/api/quotations/gmail/addon/contextual/,https://api.example.com/api/quotations/gmail/addon/action/
# GMAIL_ADDON_CONTEXTUAL_URL=https://api.example.com/api/quotations/gmail/addon/contextual/
# GMAIL_ADDON_ACTION_URL=https://api.example.com/api/quotations/gmail/addon/action/
# GMAIL_ADDON_HANDOFF_URL=https://app.example.com/admin?admin_tab=quotations&quotation_tab=inquiries
# GMAIL_ADDON_HANDOFF_TTL_SECONDS=1800
# GMAIL_ADDON_MAX_THREAD_MESSAGES=50
# Attachment evidence opened during staff review is bounded to 1-25 MiB.
# GMAIL_INQUIRY_ATTACHMENT_VIEW_MAX_BYTES=20971520

# Bounded quotation attachment parsing. Office archive limits are checked
# before openpyxl/calamine runs; fidelity-risk features remain review warnings.
# QUOTATION_IMPORT_MAX_UPLOAD_BYTES=5242880
# QUOTATION_IMPORT_MAX_EXCEL_ROWS=500
# QUOTATION_IMPORT_MAX_EXCEL_SHEETS=10
# QUOTATION_IMPORT_MAX_EXCEL_COLUMNS=100
# QUOTATION_IMPORT_MAX_PDF_PAGES=10
# PDF xref/object/stream limits run before page traversal. Decoded-stream
# coverage is exact for unfiltered and supported Flate/ASCII filter chains.
# Unsupported non-image content filters are disclosed and local extraction is
# skipped; an unsupported xref/object-stream filter fails before PdfReader.
# QUOTATION_IMPORT_MAX_PDF_OBJECTS=20000
# QUOTATION_IMPORT_MAX_PDF_STREAMS=5000
# QUOTATION_IMPORT_MAX_PDF_DECODED_STREAM_BYTES=33554432
# QUOTATION_IMPORT_MAX_PDF_TOTAL_DECODED_STREAM_BYTES=67108864
# QUOTATION_IMPORT_MAX_PDF_PAGE_DIMENSION_POINTS=10000
# QUOTATION_IMPORT_MAX_PDF_PAGE_AREA_POINTS=16000000
# QUOTATION_IMPORT_MAX_PDF_RENDER_PIXELS=25000000
# QUOTATION_IMPORT_MAX_PDF_IMAGE_PIXELS=25000000
# QUOTATION_IMPORT_MAX_PDF_TEXT_CHARS_PER_PAGE=250000
# QUOTATION_IMPORT_MAX_PDF_TOTAL_TEXT_CHARS=1000000
# QUOTATION_IMPORT_MAX_PDF_WORDS_PER_PAGE=50000
# QUOTATION_IMPORT_MAX_PDF_TOTAL_WORDS=250000
# QUOTATION_IMPORT_MAX_PDF_TABLE_ROWS=20000
# QUOTATION_IMPORT_MAX_PDF_TABLE_CELLS=100000
# QUOTATION_IMPORT_MAX_ARCHIVE_ENTRIES=2048
# QUOTATION_IMPORT_MAX_ARCHIVE_UNCOMPRESSED_BYTES=134217728
# QUOTATION_IMPORT_MAX_ARCHIVE_MEMBER_BYTES=33554432
# QUOTATION_PRICE_REFERENCE_MAX_EXCEL_ROWS=5000

# Manual quotation source retention uses a dedicated private Django storage
# alias. The default backend below remains a local filesystem, so Railway files
# are ephemeral unless this path is mounted on a persistent volume. Do not use
# the public/default Cloudinary media backend for confidential evidence.
# QUOTATION_IMPORT_STORE_SOURCE_FILES=1
# QUOTATION_PRIVATE_STORAGE_ROOT=/mounted/private/quotations
# Bounded read/write ceiling; defaults to QUOTATION_IMPORT_MAX_UPLOAD_BYTES.
# QUOTATION_PRIVATE_EVIDENCE_MAX_BYTES=5242880
# QUOTATION_EVIDENCE_STORAGE_BACKEND=quotations.private_storage.QuotationEvidenceFileSystemStorage
# Provider-specific constructor options, if an approved private backend is
# installed later. This must be one JSON object; prefer provider-native secret
# environment variables rather than embedding credentials here.
# QUOTATION_EVIDENCE_STORAGE_OPTIONS_JSON={}

# Quotation PDFs can embed uploaded branding/product images from trusted hosts.
# Keep arbitrary remote image fetching disabled unless you really need it.
QUOTATION_PDF_ALLOWED_REMOTE_IMAGE_HOSTS=res.cloudinary.com
# QUOTATION_PDF_ALLOW_REMOTE_IMAGES=0

# Cloudinary Configuration (verify the current provider plan separately)
# Sign up at https://cloudinary.com and copy your CLOUDINARY_URL
# Format: cloudinary://api_key:api_secret@cloud_name
# CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# Stripe Payment (Optional - only if using Stripe)
# STRIPE_SECRET_KEY=sk_test_your_test_key_here
# STRIPE_PUBLISHABLE_KEY=pk_test_your_test_key_here

# CORS Settings (Production)
# Comma-separated list of allowed frontend URLs
# CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Production Settings (only set these in production)
# DEBUG=0
# ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,api.yourdomain.com
# PRODUCTION_DATABASE_HOSTS=your-production-neon-host.neon.tech
# HTTPS redirect and secure-cookie settings are enabled by Django settings when
# DEBUG=0; they are not environment overrides in this release.

# Quotation AI-assisted import parsing (optional)
# API keys stay in environment variables. Staff enable/disable AI parsing from
# Admin Dashboard -> Quotations -> Settings. Leave keys blank to keep AI
# unavailable.
# OPENAI_API_KEY=sk-your-openai-key
# Anthropic is not implemented in this release; do not set it as the provider.
QUOTATION_AI_PARSE_GLOBAL_ENABLED=1
QUOTATION_AI_PARSE_PROVIDER=openai
QUOTATION_AI_PARSE_TEXT_MODEL=gpt-4.1-mini
QUOTATION_AI_PARSE_VISION_MODEL=gpt-4.1-mini
QUOTATION_AI_PARSE_MAX_TEXT_CHARS=20000
QUOTATION_AI_PARSE_MAX_PDF_PAGES=10
QUOTATION_AI_PARSE_MAX_RENDERED_PAGES=3
QUOTATION_AI_PARSE_IMAGE_MAX_DIMENSION=1400
QUOTATION_AI_PARSE_TIMEOUT_SECONDS=60
# Native Gmail PDF/Excel limits. These files are analyzed in one review-only
# request and are never persisted by the application.
QUOTATION_AI_NATIVE_TIMEOUT_SECONDS=180
QUOTATION_AI_NATIVE_MAX_FILES=12
QUOTATION_AI_NATIVE_MAX_TOTAL_BYTES=20971520
QUOTATION_AI_NATIVE_MAX_PDF_PAGES=25
# OpenAI spreadsheet augmentation reads at most the first 1,000 rows/sheet.
QUOTATION_AI_NATIVE_MAX_SPREADSHEET_ROWS_PER_SHEET=1000
# Must remain comfortably above the native AI timeout plus Gmail fetch time.
GUNICORN_TIMEOUT=300
# WEB_CONCURRENCY=2
# GUNICORN_THREADS=2
# Separate privacy opt-in for original Gmail PDF/Excel inputs. Requests
# to the configured provider use store=false and remain review-only.
QUOTATION_MAILBOX_AI_VISION_ENABLED=0

# Optional monitoring. Sentry is already installed and initializes only when
# SENTRY_DSN is present; send_default_pii remains disabled.
# SENTRY_DSN=https://public-key@your-sentry-host/project-id
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.0
# DJANGO_LOG_LEVEL=INFO
# DJANGO_REQUEST_LOG_LEVEL=ERROR
